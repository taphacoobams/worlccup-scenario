{
  "name": "senegalscenario2026",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "next dev",
    "dev:studio": "concurrently -k -n \"next,studio\" -c \"green,magenta\" \"npm run dev\" \"npm run db:studio\"",
    "credits:guardian": "tsx scripts/apply-guardian-credits.ts",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "parse-fifa": "node scripts/parse-fifa-table.mjs data/third-place-combinations.txt",
    "import-fifa:fetch": "node scripts/fetch-fifa-third-table.mjs",
    "import-fifa": "node scripts/fetch-fifa-third-table.mjs && node scripts/import-fifa-third-table.mjs",
    "sync-fixtures": "node scripts/sync-fixtures-json.mjs",
    "sync-player-photos": "node scripts/sync-player-photo-paths.mjs",
    "sync-tableau": "node scripts/sync-tableau-final.mjs",
    "parse-bracket": "node scripts/parse-bracket-table.mjs",
    "seed-worldcup": "node scripts/seed-worldcup.mjs",
    "sync-flags": "node scripts/sync-flags.mjs",
    "parse-matchs": "node scripts/parse-matchs.mjs",
    "kits:debug": "node scripts/extract-kits.mjs --debug",
    "kits:extract": "node scripts/extract-kits.mjs",
    "kits:generate": "node scripts/generate-kit-presentations.mjs",
    "matchkits:generate": "node scripts/generate-final-matchkits.mjs",
    "import-stadium-images": "tsx scripts/import-stadium-images.ts",
    "sort-fixtures": "node scripts/sort-fixtures-json.mjs",
    "parse-effectifs": "node scripts/parse-effectifs.mjs",
    "parse-players": "tsx scripts/parse-players-txt.ts",
    "merge-guardian-bios": "tsx scripts/merge-guardian-bios.ts",
    "translate-players": "tsx scripts/translate-players.ts",
    "guardian-bios": "tsx scripts/merge-guardian-bios.ts && tsx scripts/translate-players.ts --missing",
    "db:create": "tsx scripts/create-database.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/db-verify.ts",
    "db:setup": "tsx scripts/create-database.ts && prisma db push && tsx prisma/seed.ts && tsx scripts/db-verify.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts && tsx scripts/db-verify.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "pg": "^8.21.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
